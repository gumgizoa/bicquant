# ── Environment selector ──────────────────────────────────────────────────────
# Controls which config/*/dev.yaml or config/*/prod.yaml is loaded.
APP_ENV=   # dev | prod

# ── LS Securities Open API ───────────────────────────────────────────────────
LS_OPENAPI_APP_KEY=
LS_OPENAPI_APP_SECRET=
LS_OPENAPI_USER_ID=

# ── DART API ───────────────────────────────────────────────────
DART_API_KEY=

# ── KRX API ───────────────────────────────────────────────────
KRX_USERNAME=
KRX_PASSWORD=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# The Telegram group chat this bot is allowed to respond to.
# prod server:  TELEGRAM_CHAT_GROUP_ID=-1003800004196   (bicquant)
# dev server:   TELEGRAM_CHAT_GROUP_ID=-5158136283      (bicquant-dev)
TELEGRAM_CHAT_GROUP_ID=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Host-side URL (used by alembic CLI etc. running on your laptop).
# Inside docker-compose the URL is overridden per service to use the `postgres` hostname.
DATABASE_URL=postgresql://<user>:<pass>@localhost:5432/<db>

# ── Azure OpenAI ─────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── FRED API ─────────────────────────────────────────────────────────────────
FRED_API_KEY=

# ── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
